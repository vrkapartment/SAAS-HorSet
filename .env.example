# ═══════════════════════════════════════════════════════════════════════
# HorSet — Environment Variables (template)
# ═══════════════════════════════════════════════════════════════════════
# ไฟล์นี้ commit ขึ้น git ได้ — ห้ามใส่ค่าจริงในไฟล์นี้
# ใช้งาน: คัดลอกเป็น .env.local (สำหรับรันในเครื่อง) แล้วใส่ค่าจริง
# บน Vercel: Project → Settings → Environment Variables ใส่ชื่อเดียวกันทุกตัว
#
# [จำเป็น]   = ไม่ใส่แล้วแอปพัง / ไม่ปลอดภัย
# [แนะนำ]    = มีค่า fallback แต่ production ควรตั้งเอง
# [ไม่บังคับ] = ไม่ตั้งก็ได้ ฟีเจอร์นั้นจะปิดไป
#
# หมายเหตุ: Google Drive / Google Translate / SlipOK / LINE ของแต่ละหอ
# ตั้งค่าผ่านหน้า Super Admin / Settings ในแอป (เก็บใน DB) ไม่ใช่ใน env
# ═══════════════════════════════════════════════════════════════════════


# ── Supabase ─────────────────────────────────────────────────────────────
# หาได้ที่ Supabase Dashboard → Project Settings → API
# [จำเป็น]
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# [จำเป็น] anon / public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [จำเป็น] service_role key — ฝั่ง server เท่านั้น ห้ามขึ้นต้นด้วย NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=


# ── App ──────────────────────────────────────────────────────────────────
# [จำเป็น] URL ของแอป ไม่มี / ปิดท้าย
#   local:      http://localhost:3000
#   production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ── Secrets ของระบบ ──────────────────────────────────────────────────────
# สร้างค่าสุ่มด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# [จำเป็น] ใช้เข้ารหัสค่าลับที่เก็บใน DB (เช่น LINE token, Google secret)
# ⚠️ ถ้าเปลี่ยนค่านี้หลังมีข้อมูลแล้ว ค่าที่เข้ารหัสไว้เดิมจะถอดไม่ได้อีก
#    ถ้าใช้ DB เดิมที่มีข้อมูลอยู่ ต้องใช้ค่าเดิมเท่านั้น
ENCRYPTION_KEY=

# [จำเป็น] ใช้เซ็นลิงก์ Portal ของผู้เช่า (ไม่ตั้งจะ fallback ไปใช้ LINE_CHANNEL_SECRET)
# ⚠️ ถ้าเปลี่ยน ลิงก์ portal ที่ส่งให้ผู้เช่าไปแล้วจะใช้ไม่ได้
PORTAL_SIGNATURE_SECRET=

# [จำเป็นบน production] ป้องกันคนนอกยิง /api/cron/*
# Vercel Cron จะส่ง "Authorization: Bearer <CRON_SECRET>" ให้อัตโนมัติ
CRON_SECRET=


# ── LINE Messaging API (OA กลางของระบบ) ─────────────────────────────────
# หาได้ที่ LINE Developers Console → Channel → Messaging API / Basic settings
# [แนะนำ]
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# [แนะนำ] LIFF + OA default (ถ้าไม่ตั้งจะใช้ค่าที่ hardcode ไว้ในโค้ด src/lib/lineLiff.ts)
NEXT_PUBLIC_LINE_DEFAULT_LIFF_ID=
NEXT_PUBLIC_LINE_DEFAULT_BOT_BASIC_ID=
NEXT_PUBLIC_LINE_DEFAULT_BOT_NAME=


# ── Cloudflare Turnstile (กันบอทหน้า login / register) ─────────────────
# [แนะนำ] ถ้าไม่ตั้งจะใช้ test key ของ Cloudflare (ผ่านทุกครั้ง = ไม่กันบอทจริง)
# หาได้ที่ Cloudflare Dashboard → Turnstile → Add site
# ⚠️ Secret key ของ Turnstile ต้องตั้งใน Supabase: Authentication → Attack Protection → CAPTCHA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=


# ── Analytics ────────────────────────────────────────────────────────────
# [ไม่บังคับ] GA4 Measurement ID (G-XXXXXXXXXX) — ไม่ตั้ง = ไม่โหลด GA เลย
NEXT_PUBLIC_GA_MEASUREMENT_ID=


# ── QA scripts (npm run qa:*) — ไม่ต้องตั้งบน Vercel ────────────────────
# [ไม่บังคับ] ใช้กับสคริปต์ใน scripts/ เท่านั้น
QA_DB_URL=
QA_DB_KEY=
